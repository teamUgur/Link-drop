# Скопировать в backend/.env. Пустое значение = «не задано», берётся значение по умолчанию.
# В docker compose HOST, PORT, TRUST_PROXY_HOPS и TEMP_DIR задаёт docker-compose.yml — здесь не трогать.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Сколько прокси перед api. Локально 0; за Caddy — 1 (выставляет compose).
TRUST_PROXY_HOPS=0

# yt-dlp и ffmpeg локально: brew install yt-dlp ffmpeg. В образе путь уже задан.
YTDLP_PATH=yt-dlp
YTDLP_JS_RUNTIME=node
# Netscape cookies.txt технического аккаунта Instagram. В Docker файл надо смонтировать
# в контейнер (volumes: - ./secrets/cookies.txt:/run/secrets/cookies.txt:ro) и указать путь внутри.
YTDLP_COOKIES_FILE=
TEMP_DIR=/tmp/linkdrop

RESOLVE_TIMEOUT_MS=30000
DOWNLOAD_TIMEOUT_MS=600000
MAX_DURATION_SEC=3600
MAX_FILE_MB=500
# Готовый файл ждёт, пока браузер его заберёт: срок жизни и потолок числа файлов на диске
PREPARED_FILE_TTL_SEC=300
PREPARED_FILES_LIMIT=10

RESOLVE_CONCURRENCY=8
DOWNLOAD_CONCURRENCY=3
QUEUE_LIMIT=10
# Одновременных подготовок с одного IP (браузеру — всегда одна, по cookie сессии)
DOWNLOADS_PER_IP=15
# Сколько из DOWNLOAD_CONCURRENCY может занять бот MAX (строго меньше — остальное остаётся сайту)
BOT_DOWNLOAD_CONCURRENCY=2

RATE_LIMIT_RESOLVE_PER_MIN=20
RATE_LIMIT_DOWNLOAD_PER_MIN=6

# Бот MAX. Без токена бот выключен. С токеном обязателен секрет webhook (5–256 символов: a-z A-Z 0-9 _ -),
# сгенерировать: openssl rand -hex 32
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
# Публичный https-адрес webhook для npm run max:subscribe
MAX_WEBHOOK_URL=https://linkdrop.example.com/api/bots/max/webhook
MAX_API_URL=https://platform-api2.max.ru
