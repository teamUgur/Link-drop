# Переменные для docker compose (интерполяция в docker-compose.yml). Скопировать в .env.
# Переменные самого api — в server/.env.example.

# Домен сайта: Caddy сам выпустит сертификат Let's Encrypt (A-запись должна указывать на VPS,
# порты 80 и 443 открыты). Для локального стенда без HTTPS — :80
SITE_ADDRESS=linkdrop.example.com

# Публичная ссылка на бота в MAX (https://max.ru/<имя_бота>). Пусто — блок про MAX на сайте скрыт.
# Вшивается во фронт при сборке: после изменения — docker compose up -d --build web
VITE_MAX_BOT_URL=
